{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nconst { test } = require('node:test');\nconst assert = require('node:assert/strict');\nconst fs = require('node:fs/promises');\nconst os = require('node:os');\nconst path = require('node:path');\nconst { createApp } = require('./server');\n\ntest('real API persists changes, validates inputs, and serializes writes', async () => {\n  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'task-tracker-test-'));\n  const file = path.join(dir, 'tasks.json');\n  let server;\n  let base;\n  async function start() {\n    server = await createApp(file);\n    await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));\n    base = \"'`http://127.0.0.1:${server.address().port}`;\n  }\n  async function stop() { await new Promise(resolve => server.close(resolve)); }\n  async function request(route, method = '\"'GET', body) {\n    const response = await fetch(base + route, { method, headers: { 'Content-Type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });\n    return { status: response.status, value: await response.json() };\n  }\n  try {\n    await start();\n    assert.deepEqual((await request('/api/tasks')).value, []);\n    assert.equal((await request('/api/tasks', 'POST', { title: '  ' })).status, 400);\n    assert.equal((await request('/api/tasks', 'POST', { title: 'x'.repeat(201) })).status, 400);\n    assert.equal((await request('/api/tasks', 'POST', null)).status, 400);\n    const created = await request('/api/tasks', 'POST', { title: '  Real task  ' });\n    assert.equal(created.status, 201);\n    assert.equal(created.value.title, 'Real task');\n    const id = created.value.id;\n    assert.equal((await request(\"'`/api/tasks/${id}`, '\"'PATCH', { done: 'true' })).status, 400);\n    assert.equal((await request(\"'`/api/tasks/${id}`, '\"'PATCH', { done: true })).value.done, true);\n    const writes = await Promise.all(Array.from({ length: 12 }, (_, i) => request('/api/tasks', 'POST', { title: \"'`Task ${i}` })));\n    assert.ok(writes.every(r => r.status === 201));\n    await stop();\n    await start();\n    const saved = (await request('\"'/api/tasks')).value;\n    assert.equal(saved.length, 13);\n    assert.equal(saved.find(t => t.id === id).done, true);\n    assert.equal((await request(\"'`/api/tasks/${id}`, '\"'DELETE')).status, 200);\n    assert.equal((await request(\"'`/api/tasks/${id}`, '\"'DELETE')).status, 404);\n    const denied = await fetch(base + '/api/tasks', { method: 'POST', headers: { Origin: 'https://example.com', 'Content-Type': 'application/json' }, body: JSON.stringify({ title: 'Blocked' }) });\n    assert.equal(denied.status, 403);\n    for (const asset of ['/', '/app.js', '/style.css']) assert.equal((await fetch(base + asset)).status, 200);\n    assert.equal((await fetch(base + '/data/tasks.json')).status, 404);\n    await stop();\n    await start();\n    assert.equal((await request('/api/tasks')).value.length, 12);\n    await stop();\n    server = null;\n    await fs.writeFile(file, 'invalid database');\n    await assert.rejects(() => createApp(file));\n  } finally {\n    if (server) await stop();\n    // Delete only this test's known files, without recursive directory deletion.\n    await fs.unlink(file).catch(() => {});\n    await fs.unlink(file + '.tmp').catch(() => {});\n    await fs.rmdir(dir);\n  }\n});\n'@ | Set-Content -LiteralPath server.test.js\nnpm test\nnode --check app.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

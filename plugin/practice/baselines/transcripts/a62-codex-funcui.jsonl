{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\n{\n  \\\"name\\\": \\\"task-tracker\\\",\n  \\\"private\\\": true,\n  \\\"scripts\\\": { \\\"start\\\": \\\"node server.js\\\", \\\"test\\\": \\\"node --test\\\" },\n  \\\"engines\\\": { \\\"node\\\": \\\">=22\\\" }\n}\n'@ | Set-Content -LiteralPath package.json\n@'\nconst http = require('node:http');\nconst fs = require('node:fs/promises');\nconst path = require('node:path');\nconst { randomUUID } = require('node:crypto');\n\nasync function createApp(dataFile = path.join(__dirname, 'data', 'tasks.json')) {\n  await fs.mkdir(path.dirname(dataFile), { recursive: true });\n  let tasks;\n  try {\n    tasks = JSON.parse(await fs.readFile(dataFile, 'utf8'));\n    if (\"'!Array.isArray(tasks) || tasks.some(t => typeof t.id !== '\"'string' || typeof t.title \"'!== '\"'string' || typeof t.done \"'!== '\"'boolean')) throw new Error('Invalid task database');\n  } catch (error) {\n    if (error.code \"'!== '\"'ENOENT') throw error;\n    tasks = [];\n  }\n  let pending = Promise.resolve();\n  function mutate(update) {\n    const operation = pending.then(async () => {\n      const next = structuredClone(tasks);\n      const result = update(next);\n      await fs.writeFile(dataFile + '.tmp', JSON.stringify(next, null, 2));\n      await fs.rename(dataFile + '.tmp', dataFile);\n      tasks = next;\n      return result;\n    });\n    pending = operation.catch(() => {});\n    return operation;\n  }\n  function fail(status, message) { return Object.assign(new Error(message), { status }); }\n  async function body(req) {\n    if (\"'!(req.headers['\"'content-type'] || '').startsWith('application/json')) throw fail(415, 'Expected JSON');\n    const chunks = [];\n    let size = 0;\n    for await (const chunk of req) {\n      size += chunk.length;\n      if (size > 8192) throw fail(413, 'Request too large');\n      chunks.push(chunk);\n    }\n    try {\n      const value = JSON.parse(Buffer.concat(chunks).toString());\n      if (\"'!value || Array.isArray(value) || typeof value !== '\"'object') throw new Error();\n      return value;\n    } catch { throw fail(400, 'Invalid JSON object'); }\n  }\n  const assets = { '/': ['index.html', 'text/html'], '/app.js': ['app.js', 'text/javascript'], '/style.css': ['style.css', 'text/css'] };\n  return http.createServer(async (req, res) => {\n    const json = (status, value) => {\n      res.writeHead(status, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' });\n      res.end(JSON.stringify(value));\n    };\n    try {\n      // This app is local-only. Reject cross-origin writes and unexpected hosts.\n      if (\"'!/''^127'\"\\\\.0\\\\.0\\\\.1:\\\\d+\"'$/.test(req.headers.host || '\"'')) throw fail(403, 'Use the local server address');\n      if (req.headers.origin && req.headers.origin \"'!== `http://${req.headers.host}`) throw fail(403, '\"'Origin not allowed');\n      const url = new URL(req.url, 'http://127.0.0.1');\n      if (url.pathname === '/api/tasks' && req.method === 'GET') return json(200, tasks);\n      if (url.pathname === '/api/tasks' && req.method === 'POST') {\n        const input = await body(req);\n        if (typeof input.title \"'!== '\"'string' || \"'!input.title.trim() || input.title.trim().length > 200) throw fail(400, '\"'Enter a task between 1 and 200 characters');\n        const task = { id: randomUUID(), title: input.title.trim(), done: false };\n        await mutate(next => next.push(task));\n        return json(201, task);\n      }\n      const match = url.pathname.match(/\"'^'\"\\\\/api\\\\/tasks\\\\/([\"'^/]+)$/);\n      if (match && ['\"'PATCH', 'DELETE'].includes(req.method)) {\n        const input = req.method === 'PATCH' ? await body(req) : null;\n        if (input && typeof input.done \"'!== '\"'boolean') throw fail(400, 'done must be a boolean');\n        const result = await mutate(next => {\n          const index = next.findIndex(t => t.id === match[1]);\n          if (index < 0) throw fail(404, 'Task not found');\n          if (req.method === 'DELETE') return next.splice(index, 1)[0];\n          next[index].done = input.done;\n          return next[index];\n        });\n        return json(200, result);\n      }\n      if (assets[url.pathname] && req.method === 'GET') {\n        const [file, type] = assets[url.pathname];\n        const content = await fs.readFile(path.join(__dirname, file));\n        res.writeHead(200, { 'Content-Type': \"'`${type}; charset=utf-8`, '\"'X-Content-Type-Options': 'nosniff', 'Content-Security-Policy': \\\"default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'\\\" });\n        return res.end(content);\n      }\n      json(404, { error: 'Not found' });\n    } catch (error) {\n      if (\"'!error.status) console.error(error);\n      if (!res.headersSent && !res.destroyed) json(error.status || 500, { error: error.status ? error.message : '\"'Unable to save or load tasks. Please try again.' });\n    }\n  });\n}\nif (require.main === module) {\n  createApp().then(server => {\n    server.on('error', error => { console.error(error.message); process.exitCode = 1; });\n    server.listen(Number(process.env.PORT || 3000), '127.0.0.1', () => console.log(\"'`Task Tracker: http://127.0.0.1:${server.address().port}`));\n  }).catch(error => { console.error('\"'Cannot load task database:', error.message); process.exitCode = 1; });\n}\nmodule.exports = { createApp };\n'@ | Set-Content -LiteralPath server.js\n@'\n<\"'!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Task Tracker</title><link rel=\"stylesheet\" href=\"/style.css\"></head>\n<body><main>\n<h1>Task Tracker</h1>\n<form id=\"task-form\"><label for=\"title\">New task</label><div class=\"entry\"><input id=\"title\" name=\"title\" maxlength=\"200\" required placeholder=\"What needs doing?\" autocomplete=\"off\"><button id=\"add\" type=\"submit\" disabled>Add task</button></div></form>\n<p id=\"error\" role=\"alert\" hidden></p>\n<button id=\"retry\" type=\"button\" hidden>Retry loading</button>\n<p id=\"status\" role=\"status\">Loading tasks...</p>\n<ul id=\"tasks\" aria-label=\"Tasks\"></ul>\n</main><script src=\"/app.js\" defer></script></body></html>\n'\"'@ | Set-Content -LiteralPath index.html\n@'\nconst list = document.getElementById('tasks');\nconst form = document.getElementById('task-form');\nconst title = document.getElementById('title');\nconst add = document.getElementById('add');\nconst status = document.getElementById('status');\nconst error = document.getElementById('error');\nconst retry = document.getElementById('retry');\nlet tasks = [];\nlet ready = false;\nlet busy = false;\n\nasync function api(url, method = 'GET', data) {\n  const response = await fetch(url, { method, headers: data ? { 'Content-Type': 'application/json' } : {}, body: data ? JSON.stringify(data) : undefined });\n  const result = await response.json();\n  if (\"'!response.ok) throw new Error(result.error || '\"'Request failed');\n  return result;\n}\nfunction render() {\n  list.replaceChildren();\n  add.disabled = busy || \"'!ready;\n  title.disabled = busy;\n  for (const task of tasks) {\n    const li = document.createElement('\"'li');\n    const label = document.createElement('label');\n    const check = document.createElement('input');\n    check.type = 'checkbox';\n    check.checked = task.done;\n    check.disabled = busy;\n    check.addEventListener('change', () => run(async () => {\n      const updated = await api(\"'`/api/tasks/${task.id}`, '\"'PATCH', { done: check.checked });\n      tasks = tasks.map(t => t.id === updated.id ? updated : t);\n    }));\n    const text = document.createElement('span');\n    text.textContent = task.title;\n    if (task.done) text.className = 'done';\n    label.append(check, text);\n    const remove = document.createElement('button');\n    remove.type = 'button';\n    remove.textContent = 'Delete';\n    remove.setAttribute('aria-label', \"'`Delete ${task.title}`);\n    remove.disabled = busy;\n    remove.addEventListener('\"'click', () => run(async () => {\n      await api(\"'`/api/tasks/${task.id}`, '\"'DELETE');\n      tasks = tasks.filter(t => t.id \"'!== task.id);\n    }));\n    li.append(label, remove);\n    list.append(li);\n  }\n  if (ready) status.textContent = tasks.length ? `${tasks.filter(t => t.done).length} of ${tasks.length} completed` : '\"'No tasks yet. Add your first task above.';\n}\nasync function run(action) {\n  if (busy) return;\n  busy = true;\n  error.hidden = true;\n  render();\n  try { await action(); }\n  catch (e) { error.textContent = e.message || 'Unable to reach the server.'; error.hidden = false; }\n  finally { busy = false; render(); }\n}\nasync function load() {\n  retry.hidden = true;\n  status.textContent = 'Loading tasks...';\n  await run(async () => { tasks = await api('/api/tasks'); ready = true; });\n  if (\"'!ready) { status.textContent = '\"'Tasks could not be loaded.'; retry.hidden = false; }\n}\nform.addEventListener('submit', event => {\n  event.preventDefault();\n  const value = title.value.trim();\n  if (\"'!value) { title.setCustomValidity('\"'Enter a task.'); title.reportValidity(); return; }\n  run(async () => {\n    const task = await api('/api/tasks', 'POST', { title: value });\n    tasks.push(task);\n    title.value = '';\n  }).then(() => title.focus());\n});\ntitle.addEventListener('input', () => title.setCustomValidity(''));\nretry.addEventListener('click', load);\nload();\n'@ | Set-Content -LiteralPath app.js\n@'\n:root { font-family: system-ui, sans-serif; color: #20252d; background: #f5f6f8; }\nmain { max-width: 640px; margin: 64px auto; padding: 24px; background: white; border-radius: 12px; }\nh1 { margin-top: 0; }\n.entry { display: flex; gap: 10px; margin-top: 8px; }\ninput[type=text], input:not([type]) { flex: 1; min-width: 0; padding: 12px; border: 1px solid #8993a3; border-radius: 6px; font: inherit; }\nbutton { padding: 10px 14px; border: 1px solid #8993a3; border-radius: 6px; background: white; color: inherit; cursor: pointer; font: inherit; }\n#add { background: #2445a5; color: white; border-color: #2445a5; }\nbutton:disabled { opacity: .55; cursor: wait; }\nul { list-style: none; padding: 0; }\nli { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid #e4e7ed; }\nli label { display: flex; align-items: center; gap: 12px; overflow-wrap: anywhere; min-width: 0; }\ninput[type=checkbox] { width: 20px; height: 20px; flex-shrink: 0; }\n.done { text-decoration: line-through; color: #667085; }\n#error { color: #a21818; }\n:focus-visible { outline: 3px solid #769afa; outline-offset: 3px; }\n'@ | Set-Content -LiteralPath style.css\n@'\nnode_modules/\ndata/\n'@ | Set-Content -LiteralPath .gitignore\n@'\n# Task Tracker\n\nRequires Node.js 22 or newer. No dependencies to install.\n\nRun \"'`npm start`, then open http://127.0.0.1:3000. Opening index.html directly does not start the backend.\n\nAdd tasks, toggle completion, and delete tasks. Data is stored in data/tasks.json and survives server restarts. The app starts empty; no sample tasks are inserted. Back up this file while the server is stopped. Invalid existing data causes startup to fail instead of silently resetting it.\n\nRun `npm test` for API and persistence tests.\n\nThis is a local, single-user application bound to 127.0.0.1, without accounts or a hosted deployment. Run only one server against a data file. PORT can override the default port 3000.\n'\"'@ | Set-Content -LiteralPath README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\n{\n  \\\"name\\\": \\\"task-tracker\\\",\n  \\\"private\\\": true,\n  \\\"scripts\\\": { \\\"start\\\": \\\"node server.js\\\", \\\"test\\\": \\\"node --test\\\" },\n  \\\"engines\\\": { \\\"node\\\": \\\">=22\\\" }\n}\n'@ | Set-Content -LiteralPath package.json\n@'\nconst http = require('node:http');\nconst fs = require('node:fs/promises');\nconst path = require('node:path');\nconst { randomUUID } = require('node:crypto');\n\nasync function createApp(dataFile = path.join(__dirname, 'data', 'tasks.json')) {\n  await fs.mkdir(path.dirname(dataFile), { recursive: true });\n  let tasks;\n  try {\n    tasks = JSON.parse(await fs.readFile(dataFile, 'utf8'));\n    if (\"'!Array.isArray(tasks) || tasks.some(t => typeof t.id !== '\"'string' || typeof t.title \"'!== '\"'string' || typeof t.done \"'!== '\"'boolean')) throw new Error('Invalid task database');\n  } catch (error) {\n    if (error.code \"'!== '\"'ENOENT') throw error;\n    tasks = [];\n  }\n  let pending = Promise.resolve();\n  function mutate(update) {\n    const operation = pending.then(async () => {\n      const next = structuredClone(tasks);\n      const result = update(next);\n      await fs.writeFile(dataFile + '.tmp', JSON.stringify(next, null, 2));\n      await fs.rename(dataFile + '.tmp', dataFile);\n      tasks = next;\n      return result;\n    });\n    pending = operation.catch(() => {});\n    return operation;\n  }\n  function fail(status, message) { return Object.assign(new Error(message), { status }); }\n  async function body(req) {\n    if (\"'!(req.headers['\"'content-type'] || '').startsWith('application/json')) throw fail(415, 'Expected JSON');\n    const chunks = [];\n    let size = 0;\n    for await (const chunk of req) {\n      size += chunk.length;\n      if (size > 8192) throw fail(413, 'Request too large');\n      